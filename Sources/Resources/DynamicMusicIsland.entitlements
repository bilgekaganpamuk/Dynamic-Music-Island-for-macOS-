<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox Enabled (Mandatory for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network Client for Spotify/Web Album Art Downloads -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- AppleEvents Scripting Targets for Apple Music and Spotify (100% MAS Legal) -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.Music</key>
        <array>
            <string>com.apple.Music.library.read</string>
            <string>com.apple.Music.playback</string>
        </array>
        <key>com.spotify.client</key>
        <array>
            <string>com.spotify.client.playback</string>
        </array>
    </dict>

    <!-- User Selected Files Read-Only Access if custom art or assets are picked -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>
</dict>
</plist>

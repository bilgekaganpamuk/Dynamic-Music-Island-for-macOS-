<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- App Sandbox Enabled (Mandatory for Mac App Store) -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- Network Client for Spotify/Web Album Art Downloads -->
    <key>com.apple.security.network.client</key>
    <true/>

    <!-- Camera Access for FaceTime / Meeting Mirror Widget -->
    <key>com.apple.security.device.camera</key>
    <true/>

    <!-- AppleEvents Scripting Targets for Apple Music and Spotify (100% MAS Legal) -->
    <key>com.apple.security.scripting-targets</key>
    <dict>
        <key>com.apple.Music</key>
        <array>
            <string>com.apple.Music.library.read</string>
            <string>com.apple.Music.playback</string>
        </array>
        <key>com.spotify.client</key>
        <array>
            <string>com.spotify.client.playback</string>
        </array>
        <key>com.apple.Safari</key>
        <array>
            <string>com.apple.Safari.javascript</string>
        </array>
    </dict>

    <!-- User Selected Files Read-Write Access for File Shelf & AirDrop Staging -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
</dict>
</plist>
